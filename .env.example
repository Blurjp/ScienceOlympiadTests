# NextAuth Configuration
# Generate a secret using: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# Google OAuth
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App URL (update this in production)
NEXTAUTH_URL=http://localhost:3000

# Canonical site URL (used for sitemap.xml, robots.txt, and metadata)
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# OpenAI API Key (required for PDF parsing and AI test generation)
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI models per task (optional - sensible newer defaults if unset)
# OPENAI_MODEL_GRADING=gpt-5-mini      # answer grading (high volume, short outputs)
# OPENAI_MODEL_PARSING=gpt-5.4-mini    # PDF question extraction (long JSON)
# OPENAI_MODEL_GENERATION=gpt-5.1      # question generation (highest quality)

# Contact form email delivery (optional - form falls back to mailto when unset)
# Get this from https://resend.com/api-keys
# RESEND_API_KEY=re_your-resend-api-key
# Where contact form submissions are sent (defaults to support@aitrove.ai)
# CONTACT_NOTIFICATION_EMAIL=support@aitrove.ai
# Verified sender for Resend (defaults to Resend's onboarding@resend.dev)
# CONTACT_FROM_EMAIL=contact@your-domain.com

# Database - Turso (for production on Vercel)
# Get these from https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Google AdSense
# Get these from https://www.google.com/adsense
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_AD_SLOT_1=XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_AD_SLOT_2=XXXXXXXXXX

# Stripe (for subscriptions)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Create a product and price in Stripe Dashboard, then copy the price ID
STRIPE_PRO_PRICE_ID=price_your-pro-price-id
# Season Pass (one-time $19.99, Sep 1 - May 31) price ID
STRIPE_SEASON_PASS_PRICE_ID=price_your-season-pass-price-id
# Get this from Stripe Dashboard > Webhooks after creating a webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Admin dashboard credentials
# Generate a strong password: openssl rand -base64 24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-strong-admin-password
# Secret used to sign admin session cookies (falls back to AUTH_SECRET)
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=your-admin-session-secret
