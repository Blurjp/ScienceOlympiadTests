{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://sciolyprep.com/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.sciolyprep.com" }]
    }
  ],
  "functions": {
    "app/api/parse-pdf/route.ts": {
      "maxDuration": 300
    },
    "app/api/parse-pdf-vision/route.ts": {
      "maxDuration": 300
    },
    "app/api/generate-ai-test/route.ts": {
      "maxDuration": 300
    },
    "app/api/generate-from-pdf/route.ts": {
      "maxDuration": 300
    }
  }
}
